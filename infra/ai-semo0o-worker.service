[Unit]
Description=Ai Semo0o Agent Durable Worker
After=network.target

[Service]
Type=simple
User=semo0o
WorkingDirectory=/opt/ai-semo0o-agent
Environment=NODE_ENV=production
Environment=DATABASE_FILE=/var/lib/semo0o/agent.sqlite
EnvironmentFile=/etc/semo0o/agent.env
ExecStart=/usr/bin/node backend/worker.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/semo0o

[Install]
WantedBy=multi-user.target
