# =============================================================================
# backend/.env.example — copy to backend/.env (never commit the real .env)
# =============================================================================
# The backend is a long-running Node server. Run it with:
#   node --experimental-sqlite backend/server.mjs
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8787
BIND_HOST=0.0.0.0

# --- Secrets (REQUIRED in production) ----------------------------------------
# 32+ bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# --- Storage (REQUIRED in production, must be ABSOLUTE paths) ----------------
# Put the SQLite file in its OWN subdirectory: the app enforces a 0700 directory
# and refuses to start if the parent directory is world/group accessible.
#
# The client is defensive: if DATABASE_FILE is not writable (for example on a
# host without a mounted persistent disk, such as Render's Free plan) it does NOT
# crash — it falls back to ./backend/data/agent.sqlite and then to the OS temp
# dir, logging a warning. Set DATABASE_DIR instead of DATABASE_FILE if you only
# have a writable directory to point at.
DATABASE_FILE=/var/data/db/agent.sqlite
# DATABASE_DIR=/var/data/db
WORKSPACE_ROOT=/var/data/workspace

# --- CORS / frontend ---------------------------------------------------------
# Exact origin of the deployed frontend. Never use "*".
ALLOWED_ORIGIN=https://your-app.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app

# --- Background worker -------------------------------------------------------
# Set to 1 only on hosts that forbid long-running background tasks.
DISABLE_WORKER=0

# --- LLM providers (optional) ------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# --- Billing (optional) ------------------------------------------------------
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# --- Observability (optional) ------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=info
