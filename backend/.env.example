# =============================================================================
# backend/.env.example — copy to backend/.env (never commit the real .env)
# =============================================================================
# The backend is a long-running Node server. Run it with:
#   node --experimental-sqlite backend/server.mjs
#
# REQUIRED in production (NODE_ENV=production):
#   SECRETS_MASTER_KEY   — a REAL secret (32+ bytes). No default. Generate one and
#                          put it ONLY in your host's environment (Render dashboard),
#                          never in this file or in Git.
#   DATABASE_FILE        — absolute path to the SQLite file.  (has a code default)
#   WORKSPACE_ROOT       — absolute path to the agent workspace. (has a code default)
#
# DATABASE_FILE and WORKSPACE_ROOT are NON-secret storage paths and have safe
# container defaults (backend/config/runtime-defaults.mjs): when unset they resolve
# to <repo>/backend/data/... (writable on Render Free), falling back to the OS temp
# dir. Set them only to override the default (e.g. a persistent disk).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8787
BIND_HOST=0.0.0.0

# --- Secrets (REQUIRED in production) ----------------------------------------
# 32+ bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty here; set the real value in your host's environment only.
SECRETS_MASTER_KEY=

# --- Storage (REQUIRED in production, must be ABSOLUTE paths) ----------------
# OPTIONAL to set: if left empty the backend uses a writable container default
# (<repo>/backend/data/agent.sqlite, then the OS temp dir) and the SQLite client
# keeps its own fallback chain if that path is not writable.
#
# Put the SQLite file in its OWN subdirectory: the app enforces a 0700 directory
# and refuses to start if the parent directory is world/group accessible.
# Set DATABASE_DIR instead of DATABASE_FILE if you only have a writable directory.
#
# Leave these commented to use the code defaults (recommended on Render Free):
# DATABASE_FILE=/var/data/db/agent.sqlite
# DATABASE_DIR=/var/data/db
# WORKSPACE_ROOT=/var/data/workspace

# --- CORS / frontend ---------------------------------------------------------
# Exact origin of the deployed frontend. Never use "*".
# Set this in the Render dashboard (Environment) — do NOT commit the real value.
# Missing ALLOWED_ORIGIN is only a warning: it never blocks /health, but browsers
# need it to be exactly your Vercel origin or cross-origin calls are rejected.
ALLOWED_ORIGIN=https://your-app.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app

# --- Background worker -------------------------------------------------------
# Set to 1 only on hosts that forbid long-running background tasks.
DISABLE_WORKER=0

# --- LLM providers (at least ONE is required for chat / agent runs) ----------
# Configure ONE OR MORE providers. A request for a model is sent ONLY to the
# provider that serves it. If the requested model's provider is NOT configured,
# the request is transparently remapped to a configured provider's compatible
# model (a one-time `LLM_MODEL_SUBSTITUTED` warning is logged). If NONE of the
# keys below is set, chat/agent runs fail closed with a clear
# `NO_SERVER_LLM_PROVIDER_CONFIGURED` diagnostic instead of an opaque HTTP error.
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway base URL + model override.
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# Google Gemini. Either name works; GEMINI_API_KEY wins if both are set.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: web search tool.
TAVILY_API_KEY=

# --- Billing (optional) ------------------------------------------------------
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# --- Observability (optional) ------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=info
