
2) .env.example
```env
# Semo0o AI environment template
# Copy this file to .env and fill in the values that are required for your local setup.
# Do not commit real secrets.

NODE_ENV=development
PORT=8787
BIND_HOST=127.0.0.1

# Required backend storage paths
DATABASE_FILE=/absolute/path/to/backend/data/agent.sqlite
WORKSPACE_ROOT=/absolute/path/to/backend/data/workspace

# Required in production; must be a strong secret value
SECRETS_MASTER_KEY=replace_with_a_strong_secret

# Public-facing Origin for CORS protection. Keep it explicit in production.
ALLOWED_ORIGIN=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081

# LLM provider configuration (at least one is recommended)
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Observability and runtime tuning
LOG_FORMAT=pretty
RATE_LIMIT_MAX=120
WORKER_POLL_MS=250
WORKER_MAX_ATTEMPTS=3
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_RETRIES=3
AGENT_MAX_TIME_SECONDS=300
AGENT_MAX_COST_USD=5

# Billing and webhook configuration (optional unless billing is enabled)
BILLING_PROVIDER=stripe
BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Browser / CDP options (optional)
BROWSER_CDP_URL=
BROWSER_LAUNCH_LOCAL=false

# Email provider (optional)
EMAIL_PROVIDER=
EMAIL_WEBHOOK_URL=

# Optional metadata
APP_NAME=Semo0o AI
APP_ENV=development

# Extra flags
DISABLE_WORKER=0
METRICS_TOKEN=
