# =============================================================================
# Semo0o AI — Backend environment template
# =============================================================================
# Copy this file to `.env` (same directory) and fill in the values you need:
#
#     cp backend/.env.example backend/.env
#
# Rules:
#   - Never commit a real `.env` or real secrets.
#   - In production (NODE_ENV=production) the server calls assertEnv() BEFORE it
#     binds a port or opens the database, so a dangerous/incomplete config can
#     never boot. The three hard requirements are marked [PROD-REQUIRED] below.
#   - Lines starting with `#` are comments. Leave a value empty to disable it.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# HTTP port the server listens on.
PORT=8787
# Interface to bind. Leave empty for the safe default:
#   - on Render (RENDER=true) -> forced to 0.0.0.0
#   - when PORT is set (hosted platform) -> 0.0.0.0
#   - plain local run -> 127.0.0.1
BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# [PROD-REQUIRED] Absolute path to the SQLite database file.
# In dev/containers this is auto-defaulted to <repo>/backend/data/agent.sqlite
# (or <tmp>/semo0o/agent.sqlite) when left empty. The parent directory MUST be
# private (mode 0700) or the DB client refuses to start.
DATABASE_FILE=/absolute/path/to/backend/data/agent.sqlite
# [PROD-REQUIRED] Absolute path to the agent workspace root.
# Auto-defaulted to <repo>/backend/data/workspace when empty; a configured but
# non-writable path is repaired to a safe container default at boot.
WORKSPACE_ROOT=/absolute/path/to/backend/data/workspace
# Optional convenience: a writable DIRECTORY that contains the SQLite file.
# Used only when DATABASE_FILE is not set (hosts that only expose a writable dir).
DATABASE_DIR=

# -----------------------------------------------------------------------------
# Secrets & security
# -----------------------------------------------------------------------------
# [PROD-REQUIRED] Master key for the AES-256-GCM secret vault. MUST be >= 32 bytes
# (hex or base64). Generate one with:  openssl rand -base64 48
SECRETS_MASTER_KEY=replace_with_a_strong_secret
# Public-facing Origin allowed by CORS. Keep it explicit in production;
# the wildcard "*" is REJECTED in production.
ALLOWED_ORIGIN=http://localhost:8081
# Public URL of the app (used in transactional email links, etc.).
PUBLIC_APP_URL=http://localhost:8081
# Bearer token required to read /metrics. Leave empty to keep metrics private
# (unauthenticated public callers are always rejected).
METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Private-app access gate  (RECOMMENDED in production)
# -----------------------------------------------------------------------------
# This platform is a PRIVATE application: having the URL must not be enough to
# open it. Set APP_ACCESS_KEY to a strong shared enrolment key (>= 12 chars) so
# that POST /auth/register refuses anyone who does not present it. Without the
# key an outsider can never create an account, so every authenticated route
# stays closed to them. Generate one with:  openssl rand -base64 32
APP_ACCESS_KEY=
# Allow open self-service sign-up. Defaults to FALSE in production (closed) and
# TRUE in dev/test. Leave unset in production to keep the app private, or set to
# true only for a deliberately public deployment.
ALLOW_PUBLIC_REGISTRATION=
# When true, a new account gets NO session until its email is verified
# (fail-closed enrolment). Requires a working email provider to be usable.
REQUIRE_EMAIL_VERIFICATION=false
#
# FIRST ACCOUNT (bootstrap):
# If you keep sign-up closed AND do not set APP_ACCESS_KEY, there is deliberately
# no HTTP way to create an account. Create the first owner out-of-band with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-long-passphrase' \
#     npm run create:admin
# The account is written directly to the database and marked verified, so it can
# sign in immediately (even with REQUIRE_EMAIL_VERIFICATION=true).
#
# Alternatively, bootstrap the first owner from environment variables so no Shell
# is needed (handy on Render/Vercel-style hosts). Set BOTH; on boot, if — and
# only if — the database has no accounts yet, the owner is created and marked
# verified. It is a no-op once any account exists, so it is safe to leave set.
#   BOOTSTRAP_ADMIN_EMAIL=you@example.com
#   BOOTSTRAP_ADMIN_PASSWORD=a-long-passphrase   # >= 12 chars
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# LLM providers (configure at least one; otherwise a startup warning is emitted)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional per-provider model overrides. When unset, the router uses the
# catalog default for the provider (see backend/models/catalog.mjs). The value
# MUST be a model the provider actually serves, otherwise the router falls
# through to that provider's other models (and then other providers).
#   OpenAI    default: gpt-5-mini      (other: gpt-5)
#   Gemini    default: gemini-3.5-flash-lite
#             (other: gemini-3-flash-preview, gemini-3.1-pro-preview)
#   Anthropic default: claude-haiku-4-5 (other: claude-sonnet-4-6)
# NOTE: Google's 2.5 family is access-limited to past users; new projects should
# use the 3.x models above. The old `gemini-2.5-flash-lite` id is still accepted
# and transparently aliased to `gemini-3.5-flash-lite`.
OPENAI_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=

# Bounded retry backoff for transient provider errors (HTTP 429/5xx). A server
# `Retry-After` (or Gemini `retryDelay`) always takes precedence over the backoff.
LLM_RETRY_BASE_MS=500
LLM_MAX_RETRY_DELAY_MS=30000
# Web search / scrape provider (Tavily). Empty disables web.search/web.scrape.
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Real AI video generation (Text-to-Video + Image-to-Video)
# -----------------------------------------------------------------------------
# Genuine video generation (NOT image animation / GIF / camera motion). The
# preferred, first-party backend is Google Veo 3.1 via the Gemini API, which
# supports text-to-video, image-to-video, first/last-frame interpolation and
# video EXTENSION. Every path is fail-closed: with no key, the video tools
# report `unwired` and throw TOOL_CONNECTOR_NOT_CONFIGURED:video.generate.
#
# Which provider is used:
#   VIDEO_PROVIDER=google|replicate|http   (optional; otherwise auto-detected,
#                                           preferring google, then replicate, http)
#
# --- Google Veo (Gemini API) — recommended ---
# Any of these keys enables the google backend. VIDEO_API_KEY wins if set.
VIDEO_API_KEY=
# Falls back to GEMINI_API_KEY / GOOGLE_API_KEY (already listed above) if empty.
# Base URL (override only for a proxy / on-prem gateway). Default:
#   https://generativelanguage.googleapis.com/v1beta
VIDEO_API_BASE=
# Model id. Default: veo-3.1-generate-001 (stable). Alternatives:
#   veo-3.1-generate-preview, veo-3.0-generate-001
VIDEO_MODEL=
# Long-running operation polling (generation takes minutes). Bounded so a stuck
# job fails fast with VIDEO_OPERATION_TIMEOUT instead of hanging forever.
VIDEO_MAX_POLLS=60          # max poll attempts before giving up
VIDEO_POLL_MS=5000          # delay between polls (ms)
# Per-request timeouts (ms). Download is separate because the signed MP4 URL can
# be large.
VIDEO_TIMEOUT_MS=120000
VIDEO_DOWNLOAD_TIMEOUT_MS=300000

# --- Replicate (alternative text/image-to-video backend) ---
# Requires BOTH a token and a model version that accepts { prompt, image? }.
REPLICATE_API_TOKEN=
REPLICATE_API_BASE=          # default https://api.replicate.com/v1
REPLICATE_VIDEO_VERSION=     # e.g. a pinned version hash for a video model
REPLICATE_VIDEO_MODEL=       # label only, e.g. "minimax/video-01"
REPLICATE_MAX_POLLS=60
REPLICATE_POLL_MS=2000

# --- Generic HTTP backend (operator-hosted gateway) ---
# POSTs { prompt, durationSeconds, image?, video?, aspectRatio?, resolution?,
# negativePrompt? } and expects { video: { base64 | url } }.
VIDEO_HTTP_URL=
VIDEO_HTTP_SECRET=

# -----------------------------------------------------------------------------
# Real video EDITING (video-to-video) — conversational video editing
# -----------------------------------------------------------------------------
# IMPORTANT / HONEST LIMITATION: Veo generates and EXTENDS video but does NOT
# perform arbitrary editing of existing footage (re-scene / re-light / restyle a
# clip). That capability requires a dedicated video-to-video model. It is wired
# as a SEPARATE provider so the system can report `videoEditing:false` truthfully
# when only a generation backend is configured, and fails closed with
# VIDEO_EDIT_UNSUPPORTED:configure_a_video_to_video_editing_provider.
#
#   VIDEO_EDIT_PROVIDER=http|replicate
#
# --- HTTP editing endpoint (e.g. Luma Ray3 Modify / Lucy Edit / Kling O1 /
#     Wan VACE / Runway Aleph behind your own gateway) ---
# POSTs { video:{ base64, mimeType }, prompt } → { video:{ base64 | url } }.
VIDEO_EDIT_HTTP_URL=
VIDEO_EDIT_HTTP_SECRET=
VIDEO_EDIT_TIMEOUT_MS=300000

# --- Replicate video-to-video editing model version ---
# Must accept { prompt, video } (video as a data-URI).
REPLICATE_VIDEO_EDIT_VERSION=
REPLICATE_VIDEO_EDIT_MODEL=  # label only

# --- Live integration test (opt-in; costs money) ---
# Set to 1 to run backend/test/video-generation-live.test.mjs against the real
# API and verify a genuine MP4 is produced.
VIDEO_LIVE_TEST=0

# -----------------------------------------------------------------------------
# Observability & runtime tuning
# -----------------------------------------------------------------------------
# pretty | json. Without a valid value (or LOG_LEVEL) production logs a warning.
LOG_FORMAT=pretty
# Optional log level (e.g. debug | info | warn | error). Overrides LOG_FORMAT check.
LOG_LEVEL=
# Max requests per window for the distributed rate limiter.
RATE_LIMIT_MAX=120

# Worker / run-queue tuning
WORKER_POLL_MS=250
WORKER_MAX_ATTEMPTS=3
# Number of runs processed concurrently by a single worker.
WORKER_CONCURRENCY=1
# Lease/heartbeat duration (ms) before a stalled run is reclaimed (crash recovery).
WORKER_LEASE_MS=900000
# Set to 1 to start the API WITHOUT the in-process worker (run workers separately).
DISABLE_WORKER=0

# -----------------------------------------------------------------------------
# Agent runtime limits
# -----------------------------------------------------------------------------
# Values are clamped to hard caps in code — an override can only move a limit
# WITHIN its cap, never above it. Caps are shown in brackets.
AGENT_MAX_STEPS=12          # [cap 12]
AGENT_MAX_TOOL_CALLS=24     # [cap 48]
AGENT_MAX_RETRIES=2         # [cap 3]
AGENT_MAX_TOKENS=120000     # [cap 250000]
AGENT_MAX_COST_USD=2        # [cap 100]
AGENT_TIMEOUT_MS=600000     # [cap 1800000] = 10 min (max 30 min)
# NOTE: AGENT_MAX_TIME_SECONDS was documented historically but is NOT read by the
# code. The effective wall-clock limit is AGENT_TIMEOUT_MS (milliseconds).

# -----------------------------------------------------------------------------
# Browser automation (optional)
# -----------------------------------------------------------------------------
# Remote CDP endpoint; MUST start with ws:// or wss://. Prefer a wss:// fleet in
# production (in-process Chromium runs with --no-sandbox and shares the network).
BROWSER_CDP_URL=
# true = launch an in-process Chromium (warned in production).
BROWSER_LAUNCH_LOCAL=false
# Max concurrent browser contexts and per-action timeout (ms).
BROWSER_POOL_CONCURRENCY=2
BROWSER_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Transactional email (optional; fail-closed when unset)
# -----------------------------------------------------------------------------
# Provider id (e.g. webhook). BOTH provider and URL are required to send mail;
# otherwise outbox items stay queued with EMAIL_PROVIDER_NOT_CONFIGURED.
EMAIL_PROVIDER=
EMAIL_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Billing (optional; leave BILLING_PROVIDER empty to disable)
# -----------------------------------------------------------------------------
# e.g. stripe. If set, BILLING_WEBHOOK_SECRET becomes REQUIRED (>= 16 bytes).
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# -----------------------------------------------------------------------------
# Backups (optional)
# -----------------------------------------------------------------------------
# Key for the encrypted backup envelope. Falls back to SECRETS_MASTER_KEY when
# empty. Set a distinct value to keep backups decryptable independently.
BACKUP_ENCRYPTION_KEY=
