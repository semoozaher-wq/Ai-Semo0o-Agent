+# =============================================================================
+# render.yaml — Blueprint for the Ai-Semo0o-Agent BACKEND on Render.
+# =============================================================================
+# Vercel cannot run this backend (long-running Node server + node:sqlite +
+# writable disk + background worker). Render / Railway / Fly.io / a VPS can.
+#
+# HOW TO USE
+#   1. Push this repository to GitHub.
+#   2. Render Dashboard -> New -> Blueprint -> pick this repo.
+#   3. Render reads this file and creates the service.
+#   4. Fill the secret env vars in the dashboard (SECRETS_MASTER_KEY, ...).
+#
+# FREE vs PAID (read this — it is why the app used to crash on Free)
+# -----------------------------------------------------------------------------
+# The Free plan has NO persistent disk, so `/var/data` is never mounted and is
+# NOT writable. The old configuration pointed DATABASE_FILE at
+# `/var/data/db/agent.sqlite`, and the database client blindly tried to
+# `mkdir /var/data/db`, which aborted the process at boot with:
+#     EACCES: permission denied, mkdir '/var/data/db'
+# The database client is now defensive: it verifies that the target directory is
+# writable and, if not, automatically falls back to a writable location
+# (./backend/data/agent.sqlite, then the OS temp dir). So this blueprint boots on
+# the Free plan out of the box — the SQLite file just lives on the ephemeral
+# filesystem (data is reset on every deploy).
+#
+# To KEEP the database across deploys, use a paid plan and re-enable the
+# persistent disk: set `plan:` to `starter` (or higher) and uncomment the `disk:`
+# block at the bottom of this file.
+# =============================================================================
+services:
+  - type: web
+    name: ai-semo0o-backend
+    runtime: node
+    plan: free                    # Free works now (no disk). Use `starter`+disk for persistence.
+    region: frankfurt             # change to the region closest to your users
+    buildCommand: npm install     # the backend itself has no runtime deps
+    startCommand: node --experimental-sqlite backend/server.mjs
+    healthCheckPath: /health
+    autoDeploy: true
+    envVars:
+      - key: NODE_VERSION
+        value: 22.11.0            # node:sqlite needs Node >= 22.5.0
+      - key: NODE_ENV
+        value: production
+      - key: BIND_HOST
+        value: 0.0.0.0            # the server also defaults to 0.0.0.0 whenever PORT is set
+      - key: PORT
+        value: 8787
+      - key: DISABLE_WORKER
+        value: "0"                # keep the background worker running
+      # Primary database path. On a paid plan + persistent disk this is writable
+      # and persistent. On the Free plan it is NOT writable, so the client
+      # transparently falls back to ./backend/data/agent.sqlite (ephemeral).
+      # Set DATABASE_DIR instead of DATABASE_FILE if you prefer a directory.
+      - key: DATABASE_FILE
+        value: /var/data/db/agent.sqlite
+      - key: WORKSPACE_ROOT
+        value: /var/data/workspace
+      # --- Set these in the Render dashboard (do NOT commit real secrets) -----
+      # - key: SECRETS_MASTER_KEY   # 32+ bytes; generate with:
+      #                             # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
+      # - key: ALLOWED_ORIGIN       # exact origin of the Vercel frontend, e.g. https://your-app.vercel.app
+      # - key: PUBLIC_APP_URL       # same as ALLOWED_ORIGIN
+      # - key: OPENAI_API_KEY
+      # - key: ANTHROPIC_API_KEY
+      # - key: GEMINI_API_KEY
+    # --- OPTIONAL: persistent disk (requires a PAID plan) ---------------------
+    # Uncomment this block AND set `plan:` above to `starter` (or higher) to keep
+    # the SQLite database across deploys. On the Free plan there is no disk, so
+    # leave it commented out.
+    # disk:
+    #   name: data
+    #   mountPath: /var/data
+    #   sizeGB: 1
