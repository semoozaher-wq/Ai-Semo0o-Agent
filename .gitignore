# =============================================================================
# .gitignore
# =============================================================================
# This repository tracks BOTH the Expo frontend AND the Node backend, because
# the backend is deployed from git.
#
# The frontend is not allowed to bundle backend/ directly, so source trees are
# intentionally NOT ignored. Only runtime artifacts are ignored.
# =============================================================================

# --- Dependencies & tooling caches -------------------------------------------
node_modules/
.expo/
.expo-shared/
coverage/
*.tsbuildinfo

# --- Build output (regenerated by `npm run build` / Vercel) ------------------
dist/

# --- Runtime data (SQLite database + agent workspace) -----------------------
*.sqlite
*.sqlite-*
backend/data/

# --- Archives (never shipped in git) -----------------------------------------
*.zip

# --- Local secrets -----------------------------------------------------------
.env
.env.*
!.env.example

# --- OS / editor noise -------------------------------------------------------
.DS_Store
Thumbs.db

# --- Transient scratch / one-off verification scripts ------------------------
# The tmp/ directory is for throwaway verification scripts that must never be
# committed; the durable tooling lives in scripts/.
tmp/
