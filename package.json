{
  "name": "ai-semo0o-agent",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "description": "Semo0o AI — Integrated autonomous AI agent platform (agents, chat, studio, operations, data engine)",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "export:web": "expo export --platform web",
    "verify:web": "node scripts/verify-web-bundle.mjs",
    "build": "npm run export:web && npm run verify:web",
    "release:gate": "npm run typecheck && npm run check:imports && npm run test:phase1 && npm run test:frontend",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/verify-imports.mjs src && node scripts/verify-imports.mjs app",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "security:scan": "node scripts/security-scan.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:gate": "node scripts/audit-gate.mjs",
    "test": "npm run test:legacy-harness && npm run test:execution && npm run test:phase1 && npm run test:frontend && npm run test:phase2 && npm run test:backend && npm run validate:pain-map",
    "test:legacy-harness": "tsx test/harness.ts",
    "test:execution": "node --experimental-sqlite --test test/*.test.mjs",
    "test:phase2": "node --test test/phase2-core.test.mjs test/phase2-intelligence.test.mjs",
    "test:phase1": "tsx --test test/phase1-orchestrator.test.ts test/code-run-integration.test.ts test/model-router.test.ts test/recovery-contract.test.ts",
    "test:frontend": "tsx --test test/backend-url.test.ts test/chat-stream.test.ts test/chat-recovery.test.ts test/account-security.test.ts test/auth-gate.test.ts test/device-approval-readiness.test.ts",
    "test:backend": "node --experimental-sqlite --test backend/test/*.test.mjs",
    "create:admin": "node --experimental-sqlite scripts/create-admin.mjs",
    "start:backend": "node --experimental-sqlite backend/server.mjs",
    "start:worker": "node --experimental-sqlite backend/worker.mjs",
    "test:browser-smoke": "npm run build && node scripts/browser-smoke.mjs",
    "test:browser-e2e": "node --experimental-sqlite scripts/browser-e2e.mjs",
    "generate:anatomy": "node scripts/generate-317-pain-map.js data/anatomyPainMap.json",
    "validate:pain-map": "node scripts/validate-pain-map.js data/anatomyPainMap.json",
    "smoke:backend": "bash scripts/boot-smoke.sh",
    "benchmark:agent": "node --experimental-sqlite scripts/agent-benchmark.mjs",
    "benchmark:capabilities": "node --experimental-sqlite scripts/capability-benchmark.mjs",
    "trial:self-improve": "node --experimental-sqlite scripts/production-trial.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "jszip": "3.10.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.14",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "uuid": "11.1.1"
  }
}
